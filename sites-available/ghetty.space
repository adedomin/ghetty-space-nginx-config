server {
    server_name ghetty.space;
    listen [::]:80;
    
    include snippets/acme_challenge;
    include snippets/default_redirect;
}

server {
    server_name ghetty.space;

    include snippets/listen_norm;
    include snippets/tls_params;

    root /var/www/ghetty;

    location / {
        index index.html;
    }

    location /my-ip {
        default_type text/plain;
        return 200 "$remote_addr\n";
    }
}
