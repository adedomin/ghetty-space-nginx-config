upstream rspamd {
    server unix:///run/rspamd/web.sock;
}

server {
    server_name dedominic.pw;
    listen [::]:443 ssl ipv6only=off default_server;
    http2 on;

    include snippets/tls_params;

    location /my-ip {
        default_type text/plain;
        return 200 "$remote_addr\n";
    }

    location /my-ip-binary {
        default_type application/octet-stream;
        return 200 "$binary_remote_addr";
    }

    location /my-ip-48 {
        default_type application/octet-stream;
        return 200 "$subnet48";
    }

    location / {
        root /var/www/html;
    }

    location /rspamd/ {
        include snippets/proxy_forward_headers;
        proxy_pass http://rspamd/;
    }
}
